  <world name='default'>
    <!-- FAIR copy of chain_robot_ros2/worlds/UNIST_indoor.world: the 9 'unit_box' test obstacles
         (narrow gaps for chain_robot experiments, impassable for the relay cars) are removed,
         leaving the plain 54 x 15 m corridor ring of UNIST building 112, 8th floor. The saved <state>
         snapshot (old poses, sim time 38:50) is removed too. -->
