    <gui fullscreen='0'>
      <!-- recordings: straight down over the whole 54 x 15 m floor, +x right, +y up -->
      <camera name='user_camera'>
        <pose>-0.4 -1.35 50 0 1.5707 1.5707</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <audio>
      <device>default</device>
    </audio>

     <!-- 체인 로봇  -->
    <include>
      <uri>model://chain_robot</uri>
      <pose>-0.5 -6 0.0 0 0 0</pose>

      <plugin name="chain_robot_plugin2" filename="libchain_robot_plugin2.so"/>

      <plugin name="gazebo_ros_joint_state_publisher"
              filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>100</update_rate>
        <joint_name>joint_module_1_joint</joint_name>
        <joint_name>joint_module_2_joint</joint_name>
        <joint_name>joint_module_3_joint</joint_name>
        <joint_name>joint_module_4_joint</joint_name>
        <joint_name>joint_module_5_joint</joint_name>
        <joint_name>joint_module_6_joint</joint_name>
      </plugin>
    </include>


  </world>
</sdf>
