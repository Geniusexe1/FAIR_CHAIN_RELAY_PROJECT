<?xml version="1.0"?>
<model>
  <name>saye_classic</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>
    Ackermann relay vehicle, ported from the Gazebo Harmonic saye model
    (mesh_sim_ws) to Gazebo Classic 11 so it can share a world with chain_robot.
    ${NS} is substituted at spawn time by spawn_saye.py.
  </description>
</model>
